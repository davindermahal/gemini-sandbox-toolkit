# Copy to ~/.gemini-sandbox/env and fill in what applies to you. Every value here is optional --
# bin/gemini-sandbox skips anything unset rather than failing, so this works even if you only
# want the sandbox + chrome-devtools-mcp and don't use ai-intake-mcp at all.

# Absolute path to your local ai-intake-mcp checkout (the repo that has dist/index.js), if you use
# it. See https://github.com/davindermahal/ai-intake-mcp
AI_INTAKE_MCP_DIR=/path/to/your/ai-intake-mcp
