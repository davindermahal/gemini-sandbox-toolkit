# Copy to ~/.gemini-sandbox/env and fill in what applies to you. Everything below is entirely
# optional -- install.sh works with none of this set: ai-intake-mcp and ai-intake-documentation-mcp
# are baked into the sandbox image at pinned published versions by default. Only set these two
# vars if you're actively developing one of those servers and want the sandbox to use your local
# clone (git pull + npm build) instead, without publishing a new version each time.

# Absolute path to your local ai-intake-mcp checkout (the repo that has dist/index.js). See
# https://github.com/davindermahal/ai-intake-mcp
AI_INTAKE_MCP_DIR=/path/to/your/ai-intake-mcp

# Absolute path to your local ai-intake-documentation-mcp checkout (the monorepo whose built
# server lives at packages/documentation-mcp/dist/index.js). See
# https://github.com/davindermahal/ai-intake-documentation-mcp
AI_INTAKE_DOCUMENTATION_MCP_DIR=/path/to/your/ai-intake-documentation-mcp
