#!/usr/bin/env bash
# Shared Gemini CLI sandbox wrapper -- usable from any project directory. Run from a project, it
# sandboxes `gemini` and mounts that project's cwd in automatically (Gemini's own behavior, not
# anything this script does); MCP server registration lives in ~/.gemini/settings.json (global,
# set up by install.sh), not here, since the same MCP servers are meant to be available in every
# project. See https://github.com/davindermahal/gemini-sandbox-toolkit-demo 's
# .ai/guides/gemini-docker-sandbox-mcp.md for the full reasoning.
set -euo pipefail

# readlink -f resolves the symlink chain BEFORE computing the directory -- required because
# install.sh installs this script as a symlink at ~/.local/bin/gemini-sandbox. Without it,
# ${BASH_SOURCE[0]} reports the symlink's own path when invoked via PATH (as `gemini-sandbox`,
# the normal way), not the real file it points to, so TOOLKIT_DIR silently resolved to
# ~/.local (the symlink's parent's parent) instead of ~/.gemini-sandbox -- env, at
# ~/.local/env, was never found, AI_INTAKE_MCP_DIR was never set, and the ai-intake mount was
# silently never added to SANDBOX_MOUNTS. Confirmed via `bash -x`: direct invocation
# (~/.gemini-sandbox/bin/gemini-sandbox) computed TOOLKIT_DIR correctly and masked this for
# every manual test; only invoking it as `gemini-sandbox` through the installed symlink (the
# only way it's actually used day to day) hit the bug.
TOOLKIT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# This script owns SANDBOX_MOUNTS and SANDBOX_FLAGS entirely (both built fresh below) rather than
# trusting whatever's already exported -- a stray SANDBOX_FLAGS or SANDBOX_MOUNTS left over from an
# earlier manual setup attempt would otherwise silently combine with this script's own. Note that
# editing .bashrc to remove an old export and re-sourcing it does NOT unset a variable already
# exported in the current shell -- only `unset` or a fresh shell does. Assigning fresh below
# (rather than unsetting) discards any such stray value the same way.

ENV_FILE="$TOOLKIT_DIR/env"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

# GEMINI_SANDBOX=docker enables the sandbox directly (env var, documented behavior) -- no
# settings.json tools.sandbox needed, deliberately: setting that globally would force every
# bare `gemini` invocation on this machine into sandbox mode, including one-off usage outside any
# project. This wrapper is the opt-in; plain `gemini` stays unsandboxed.
export GEMINI_SANDBOX=docker
export GEMINI_SANDBOX_IMAGE=gemini-sandbox:latest

# No docker.sock mount here, deliberately: the sandbox does not get access to the host's Docker
# daemon (that would let anything running inside the sandbox control Docker on the host, i.e.
# root-equivalent access). SANDBOX_MOUNTS is built up from scratch below, comma-separated, with no
# entry unless something is actually configured.
SANDBOX_MOUNTS=""
unset SANDBOX_FLAGS
add_mount() {
  if [[ -z "$SANDBOX_MOUNTS" ]]; then
    SANDBOX_MOUNTS="$1"
  else
    SANDBOX_MOUNTS="$SANDBOX_MOUNTS,$1"
  fi
}

# ai-intake-mcp local-dev override, if configured (env.example): both ai-intake-mcp and
# ai-intake-documentation-mcp are baked into the image at pinned published versions by default
# (sandbox.Dockerfile) -- this mount + merge-settings.js's matching override only kick in if
# AI_INTAKE_MCP_DIR is set to a real local clone, letting you iterate (git pull + npm build)
# without publishing a new version and rebuilding the image each time. Skipped entirely if not
# configured -- install.sh alone is sufficient without this.
if [[ -n "${AI_INTAKE_MCP_DIR:-}" && -d "$AI_INTAKE_MCP_DIR" ]]; then
  AI_INTAKE_MCP_CONFIG_DIR="$HOME/.config/ai-intake-mcp"
  add_mount "$AI_INTAKE_MCP_DIR:$AI_INTAKE_MCP_DIR:ro"
  if [[ -d "$AI_INTAKE_MCP_CONFIG_DIR" ]]; then
    add_mount "$AI_INTAKE_MCP_CONFIG_DIR:$AI_INTAKE_MCP_CONFIG_DIR:ro"
  fi
fi

# ai-intake-documentation-mcp local-dev override, same convention as ai-intake-mcp above -- an
# npm-workspaces monorepo, built locally once (`npm install && npm run build`, produces
# packages/documentation-mcp/dist/index.js), no config dir of its own (it works against the
# mounted project's own .ai/ directory, not host-level state).
if [[ -n "${AI_INTAKE_DOCUMENTATION_MCP_DIR:-}" && -d "$AI_INTAKE_DOCUMENTATION_MCP_DIR" ]]; then
  add_mount "$AI_INTAKE_DOCUMENTATION_MCP_DIR:$AI_INTAKE_DOCUMENTATION_MCP_DIR:ro"
fi

# SANDBOX_MOUNTS entries must exist on the host or gemini refuses to start (FatalSandboxError:
# "Missing mount path") -- so this is conditional, not hardcoded. Without it, admin-tier Policy
# Engine rules at the standard system location are invisible inside the sandbox: it isn't one of
# gemini's own auto-mounts (workspace, ~/.gemini, tmpdir, ~/.config/gcloud,
# GOOGLE_APPLICATION_CREDENTIALS).
ADMIN_POLICY_DIR="/etc/gemini-cli/policies"
if [[ -d "$ADMIN_POLICY_DIR" ]]; then
  add_mount "$ADMIN_POLICY_DIR:$ADMIN_POLICY_DIR:ro"
fi

if [[ -n "$SANDBOX_MOUNTS" ]]; then
  export SANDBOX_MOUNTS
else
  unset SANDBOX_MOUNTS
fi

# make-runner-mcp discovery: set or prune the CURRENT project's makeRunner entry in its own
# .gemini/settings.json (Gemini merges global + project-scoped settings automatically, so this
# only ever needs to touch this one key -- everything else a project's settings.json might already
# have, plus the global chrome-devtools/ai-intake registrations, are untouched/handled elsewhere).
# See mcp-runner-lib.sh and gemini-sandbox-mcp-up for why this is a per-project, explicit-opt-in
# thing rather than a global registration the way chrome-devtools-mcp/ai-intake-mcp are.
# shellcheck disable=SC1091
source "$TOOLKIT_DIR/bin/mcp-runner-lib.sh"
PROJECT_DIR="$(pwd -P)"
MCP_STATE_DIR="$(mcp_runner_state_dir "$PROJECT_DIR")"
PROJECT_SETTINGS="$PROJECT_DIR/.gemini/settings.json"

if mcp_runner_is_alive "$MCP_STATE_DIR"; then
  MCP_RUNNER_MODE=set \
  MCP_RUNNER_SETTINGS_PATH="$PROJECT_SETTINGS" \
  MCP_RUNNER_URL="http://host.docker.internal:$(cat "$MCP_STATE_DIR/port")/mcp" \
  MCP_RUNNER_TOKEN="$(cat "$MCP_STATE_DIR/token")" \
    node "$TOOLKIT_DIR/merge-project-settings.js"
elif [[ -d "$MCP_STATE_DIR" ]]; then
  # A state directory exists (this project has used the feature before -- gemini-sandbox-mcp-up
  # creates it on first run and gemini-sandbox-mcp-down deliberately leaves it in place, removing
  # only the now-dead pid file) but no process group is currently alive -- distinct from "never
  # used here" (see mcp-runner-lib.sh): tell the user, and prune the now-stale entry rather than
  # leaving a permanently "Connection closed" registration behind.
  echo "Note: make-runner-mcp is not running for this project -- run 'gemini-sandbox-mcp-up' first for Docker-driven make targets to be reachable." >&2
  MCP_RUNNER_MODE=prune \
  MCP_RUNNER_SETTINGS_PATH="$PROJECT_SETTINGS" \
    node "$TOOLKIT_DIR/merge-project-settings.js"
elif [[ -f "$PROJECT_DIR/Makefile" ]]; then
  # Never used here, and there's a Makefile -- a one-line, non-blocking hint that this exists,
  # nothing more. No state is created or written by this branch (no marker file to remember it was
  # shown) -- deliberately, so a project that's never touched this feature stays completely
  # untouched (no new files at all) until someone actually opts in.
  echo "Tip: this project has a Makefile -- run 'gemini-sandbox-mcp-up' once to make its targets reachable from inside this sandbox." >&2
fi

exec gemini "$@"
