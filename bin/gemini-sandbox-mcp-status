#!/usr/bin/env bash
# Checks whether a make-runner-mcp process group is running for the CURRENT project (cwd).
set -euo pipefail

LIB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1091
source "$LIB_DIR/mcp-runner-lib.sh"

STATE_DIR="$(mcp_runner_state_dir "$(pwd -P)")"

if mcp_runner_is_alive "$STATE_DIR"; then
  echo "running (pgid $(cat "$STATE_DIR/pid"), port $(cat "$STATE_DIR/port"))"
else
  echo "not running"
fi
