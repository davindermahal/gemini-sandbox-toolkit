#!/usr/bin/env bash
# Force-stops every make-runner-mcp instance on this machine, across every project -- the panic
# button for "something is stuck/misbehaving and I don't want to hunt down which project's
# directory it belongs to first." Same TERM-then-KILL process-group logic as
# gemini-sandbox-mcp-down (see that script's comment for why the whole group, not just the
# originally-recorded PID), just looped over every state directory instead of the one for cwd.
#
# Same as gemini-sandbox-mcp-down, port/token state is left in place, not deleted, so the next
# gemini-sandbox-mcp-up in each project reuses its existing token rather than generating a new one.
set -euo pipefail

LIB_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck disable=SC1091
source "$LIB_DIR/mcp-runner-lib.sh"

shopt -s nullglob
state_dirs=("$MCP_RUNNER_STATE_ROOT"/*/)
shopt -u nullglob

if [[ ${#state_dirs[@]} -eq 0 ]]; then
  echo "No make-runner-mcp instances to stop."
  exit 0
fi

for state_dir in "${state_dirs[@]}"; do
  proj="$(cat "${state_dir}project-dir" 2>/dev/null || echo "(unknown)")"
  if mcp_runner_is_alive "$state_dir"; then
    pgid="$(cat "${state_dir}pid")"
    kill -TERM "-$pgid" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      kill -0 "-$pgid" 2>/dev/null || break
      sleep 1
    done
    kill -KILL "-$pgid" 2>/dev/null || true
    rm -f "${state_dir}pid"
    echo "stopped: $proj"
  else
    echo "already stopped: $proj"
  fi
done
